<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ViewTask</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav aria-label="Main navigation">
            <a class="brand" asp-controller="Home" asp-action="Index">ViewTask</a>
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a asp-controller="Tasks" asp-action="SprintTasks">Sprint Tasks</a>
        </nav>
    </header>
    <main class="container">@RenderBody()</main>
    <footer class="container">&copy; @DateTime.UtcNow.Year - ViewTask - <a asp-controller="Home" asp-action="Privacy">Privacy</a></footer>
</body>
</html>