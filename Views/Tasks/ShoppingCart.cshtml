@model ShoppingCartModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Your shopping cart";
    DateTime today = ViewBag.Today;
}
<h1>Your shopping cart</h1>
@if (ViewBag.Sent == true)
{
    <p role="status">Your products will be shipped at: @Model.Address. Bon appetite, @Model.FullName!</p>
    <p>Supermarket: @Model.Supermarket</p>
    <p>Delivery date: @Model.DeliveryDate.ToString("dd.MM.yyyy")</p>
    <p>Products: @string.Join(", ", Model.Products)</p>
}
@using (Html.BeginForm("ShoppingCart", "Tasks", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false)
    <p>
        @Html.Label("FullName", "Full name")<br />
        @Html.TextBox("FullName", Model.FullName, new { maxlength = 100, required = "required" })
    </p>
    <p>
        @Html.Label("Address", "Delivery address")<br />
        @Html.TextBox("Address", Model.Address, new { maxlength = 250, required = "required" })
    </p>
    <p>
        @Html.Label("Supermarket", "Supermarket")<br />
        @Html.DropDownList("Supermarket", new SelectList((List<string>)ViewBag.Supermarkets, Model.Supermarket), "Choose a supermarket")
    </p>
    <fieldset>
        <legend>Delivery date</legend>
        @for (var i = 0; i < 3; i++)
        {
            var date = today.AddDays(i);
            var id = $"delivery-{i}";
            @Html.RadioButton("DeliveryDate", date.ToString("yyyy-MM-dd"), Model.DeliveryDate == date, new { id })
            <label for="@id">@date.ToString("dd.MM.yyyy")</label><br />
        }
    </fieldset>
    <p>
        @Html.Label("Products", "Products (hold Ctrl to select several)")<br />
        @Html.ListBox("Products", new MultiSelectList((List<string>)ViewBag.Products, Model.Products), new { size = 5 })
    </p>
    <button type="submit">Send</button>
}